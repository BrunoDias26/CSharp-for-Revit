
<Project Sdk="Nice3point.Revit.Sdk/6.2.2">

	<PropertyGroup>
		<UseWPF>true</UseWPF>
		<DeployAddin>true</DeployAddin>
		<LaunchRevit>true</LaunchRevit>
		<IsRepackable>false</IsRepackable>
		<EnableDynamicLoading>true</EnableDynamicLoading>
		<Configurations>Debug.R23;Debug.R24;Debug.R25;Debug.R26;Debug.R27</Configurations>
		<Configurations>$(Configurations);Release.R23;Release.R24;Release.R25;Release.R26;Release.R27</Configurations>
		<RootNamespace>CSharp_for_Revit</RootNamespace>
		<UseWindowsForms>true</UseWindowsForms>
	</PropertyGroup>

	<!-- Product identity: the DLL and its Addins folder are named "CodeLab" (same name as the Ribbon tab).
	     RootNamespace stays CSharp_for_Revit: icons, tooltips and buttons are found by that prefix.
	     Version: change it only here; Globals reads it back from the DLL. -->
	<PropertyGroup>
		<AssemblyName>CodeLab</AssemblyName>
		<Product>CodeLab</Product>
		<Company>CodeLab</Company>
		<Version>1.0.0</Version>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Resources\Icons16\*.png" />
		<None Remove="Resources\Icons16\*.ico" />
		<None Remove="Resources\Icons16\*.png" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Include="Resources\Icons16\*.png" />
		<EmbeddedResource Include="Resources\Icons16\*.ico" />
	  <EmbeddedResource Include="Resources\Icons32\*.png" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="ClosedXML" Version="0.105.1" />
		<PackageReference Include="Nice3point.Revit.Toolkit" Version="$(RevitVersion).*" />
		<PackageReference Include="Nice3point.Revit.Extensions" Version="$(RevitVersion).*" />
		<PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" />
		<PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" />

		<PackageReference Include="WindowsAPICodePack-Shell" Version="1.1.1" />

		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />

		<PackageReference Include="JetBrains.Annotations" Version="2025.2.4" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Models" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Resources\Files\Tooltips.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Tooltips.resx</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Update="Resources\Files\Tooltips.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <LastGenOutput>Tooltips.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	</ItemGroup>

</Project>