<Window
    x:Class="CodeLab.Forms.Bases.BaseLineOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Pick line and window"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="Manual"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True">

    <!-- Sharp text (2026-10-29): a transparent window has no ClearType, so the small texts looked soft next to
         Revit's. TextFormattingMode="Display" fits the letters to the pixel grid, UseLayoutRounding avoids
         half-pixel positions, and the pill's shadow is kept OFF the text (see the pill below). -->

    <!-- Colors in one place (Windows 11 blue). #AARRGGBB: the first 2 digits are the opacity (26 = ~15%). -->
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
        <SolidColorBrush x:Key="AccentFillBrush" Color="#260078D4" />
        <SolidColorBrush x:Key="PillBrush" Color="#E6202124" />
        <SolidColorBrush x:Key="EdgeLabelBackgroundBrush" Color="#D9FFFFFF" />
        <SolidColorBrush x:Key="EdgeLabelTextBrush" Color="#6B6B6B" />
    </Window.Resources>

    <Grid>
        <!-- Almost transparent background (#01 = 1 of 255): invisible, but it receives the mouse.
             A 100% transparent background lets the clicks pass through. -->
        <Canvas x:Name="DrawingCanvas" Background="#01000000" Cursor="Cross">

            <!-- The read window (3rd click): light blue, rounded corners, dashed border -->
            <Rectangle x:Name="ReadWindow"
                       Fill="{StaticResource AccentFillBrush}"
                       Stroke="{StaticResource AccentBrush}"
                       StrokeThickness="1.5"
                       StrokeDashArray="4 3"
                       RadiusX="6"
                       RadiusY="6"
                       Visibility="Collapsed" />

            <!-- The line (1st and 2nd clicks): thin, with round ends -->
            <Line x:Name="OuterRowLine"
                  Stroke="{StaticResource AccentBrush}"
                  StrokeThickness="2"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  Visibility="Collapsed" />

            <!-- Dots on the clicked points (like the handles of a drawing tool) -->
            <Ellipse x:Name="StartDot"
                     Width="8"
                     Height="8"
                     Fill="White"
                     Stroke="{StaticResource AccentBrush}"
                     StrokeThickness="2"
                     Visibility="Collapsed" />

            <Ellipse x:Name="EndDot"
                     Width="8"
                     Height="8"
                     Fill="White"
                     Stroke="{StaticResource AccentBrush}"
                     StrokeThickness="2"
                     Visibility="Collapsed" />

            <!-- Label of the window's moving edge (3rd click only): the largest dimensions end there.
                 Minimal: gray text on a soft white pad, so it reads over the drawing without a box -->
            <Border x:Name="EdgeLabel"
                    Background="{StaticResource EdgeLabelBackgroundBrush}"
                    CornerRadius="3"
                    Padding="4,1"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <TextBlock Text="Dimensions align here"
                           Foreground="{StaticResource EdgeLabelTextBrush}"
                           FontSize="11" />
            </Border>
        </Canvas>

        <!-- Hint "pill" at the bottom: step counter + text + ESC key.
             IsHitTestVisible=False: clicks go through it to the canvas -->
        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Margin="0,0,0,24"
              IsHitTestVisible="False">

            <!-- Background + shadow only, behind the text. An Effect draws its content as a picture and blurs
                 small text, so the shadow lives here and the text border below has no Effect. -->
            <Border CornerRadius="16" Background="{StaticResource PillBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35" />
                </Border.Effect>
            </Border>

            <!-- The pill's content: same size as the shadow border (both fill the same Grid cell) -->
            <Border Padding="8,6,14,6" CornerRadius="16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Step counter: 1/3, 2/3, 3/3 -->
                    <Border Background="{StaticResource AccentBrush}" CornerRadius="9" Padding="7,1">
                        <TextBlock x:Name="StepText" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                    </Border>

                    <TextBlock x:Name="HintText" Foreground="White" FontSize="12" Margin="10,0,14,0" VerticalAlignment="Center" />

                    <!-- The ESC key drawn as a small key -->
                    <Border BorderBrush="#99FFFFFF" BorderThickness="1" CornerRadius="4" Padding="5,0">
                        <TextBlock Text="ESC" Foreground="White" FontSize="10" />
                    </Border>

                    <TextBlock Text="cancel" Foreground="#CCFFFFFF" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
